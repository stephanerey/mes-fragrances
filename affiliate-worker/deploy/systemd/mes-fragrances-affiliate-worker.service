[Unit]
Description=Mes Fragrances affiliate worker pipeline
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/eva/mes-fragrances
EnvironmentFile=-/home/eva/mes-fragrances/affiliate-worker/.host-email-report.env
ExecStart=/home/eva/mes-fragrances/affiliate-worker/deploy/run_daily_affiliate_pipeline.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
